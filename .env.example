VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Keep false in production. Bundled stations are used only when Supabase is unavailable.
VITE_ENABLE_DEMO_DATA=false

# Use contracted/self-hosted map and routing services in production.
VITE_MAP_TILE_URL=https://your-tile-provider/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
VITE_ROUTING_BASE_URL=https://your-routing-service

# Never put private AI, payment or service-role secrets in VITE_* variables.
# Configure GROQ_API_KEY and payment secrets with `supabase secrets set`.
